{
  "name": "crypto-alert-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side alert engine, push delivery and subscription enforcement for the Crypto Alert iOS app.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
    "migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/store/migrate.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^1.5.0",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.0"
  }
}
