# ---- Server ----
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ---- Storage ----
# Leave unset to run fully in memory (development only; everything is lost on restart).
DATABASE_URL=postgres://cryptoalert:cryptoalert@localhost:5432/cryptoalert

# ---- Price feeds ----
# Comma separated, first is preferred. Binance streams USDT pairs; CoinGecko polls the curated catalogue.
FEEDS=binance,coingecko
# Optional CoinGecko demo key (raises the free rate limit). For a paid key also set the pro base URL in code.
COINGECKO_API_KEY=
COINGECKO_POLL_SECONDS=60
# Extra CoinGecko ids for symbols outside the catalogue, e.g. PEPE=pepe,WIF=dogwifcoin
COINGECKO_IDS=
# Seed 25 h of 5 minute candles from Binance when a symbol is first tracked (needed for percent-change alerts).
BINANCE_BACKFILL=true

# ---- Engine ----
HYSTERESIS_PERCENT=0.5
STALE_AFTER_SECONDS=90
INDEX_REFRESH_SECONDS=30

# ---- Apple Push Notification service (token based auth) ----
# Create a key with the APNs service enabled in the Apple Developer portal (Keys) and download the .p8 once.
APNS_TEAM_ID=
APNS_KEY_ID=
# Either paste the .p8 contents (newlines as \n) or point at the file.
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=./secrets/AuthKey.p8
APNS_BUNDLE_ID=com.trainabit.cryptoalert

# ---- App Store purchases ----
# Bundle id used to verify StoreKit transactions and App Store Server Notifications (defaults to APNS_BUNDLE_ID).
APPSTORE_BUNDLE_ID=com.trainabit.cryptoalert
# Sandbox while testing with TestFlight or Xcode; Production for the live app.
APPSTORE_ENVIRONMENT=Sandbox
# Numeric Apple id of the app from App Store Connect; required in Production.
APPSTORE_APP_APPLE_ID=
# Directory with Apple's DER root certificates (AppleRootCA-G3.cer ships in ./certs).
APPLE_ROOT_CERTS_DIR=./certs
# Product ids that unlock Pro; must match App Store Connect and the StoreKit configuration.
PRO_PRODUCT_IDS=com.trainabit.cryptoalert.pro.monthly,com.trainabit.cryptoalert.pro.yearly,com.trainabit.cryptoalert.pro.lifetime

# ---- Sign in with Apple ----
# Audience of identity tokens: the app's bundle id (defaults to APPSTORE_BUNDLE_ID / APNS_BUNDLE_ID).
APPLE_SIGN_IN_BUNDLE_ID=com.trainabit.cryptoalert
